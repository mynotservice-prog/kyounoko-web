# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# scripts intermediate (image-prompts dry-run output)
/tmp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/

# local test/maintenance scripts (archived)
scripts/_archived-*

# backup files (sed -i .bak / mv-aside leftovers - typically from in-sandbox edits where unlink is restricted)
*.bak
*.bak.*

# 大型unsplash素材（参照ゼロ・2026-05退役）
public/new_hero/
# public/hero/ の重いPNGのみ除外。プランが参照する軽量webpは追跡する
public/hero/*.png
# sed等の一時バックアップ
*.bak
