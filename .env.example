# ==========================================================================
# きょうのこ 環境変数テンプレート
# 実際の値は .env.local にコピーしてください（.gitignoreで除外）
# ==========================================================================

# MicroCMS（必須）
MICROCMS_SERVICE_DOMAIN=kyounoko
MICROCMS_API_KEY=your-api-key-here

# Google Analytics 4（オプション・取得後に設定）
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Microsoft Clarity（オプション・ヒートマップ用）
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# サイトURL（本番ではkyounoko.jp、ローカル開発ではlocalhost）
NEXT_PUBLIC_SITE_URL=https://kyounoko.jp
