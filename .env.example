# ==========================================================================
# きょうのこ 環境変数テンプレート
# 実際の値は .env.local にコピーしてください（.gitignoreで除外）
# ==========================================================================

# MicroCMS（必須）
MICROCMS_SERVICE_DOMAIN=kyounoko
MICROCMS_API_KEY=your-api-key-here

# Google Analytics 4（オプション・取得後に設定）
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Microsoft Clarity（オプション・ヒートマップ用）
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx

# サイトURL（本番ではkyounoko.jp、ローカル開発ではlocalhost）
NEXT_PUBLIC_SITE_URL=https://kyounoko.jp

# ==========================================================================
# アフィリエイト収益化（オプション・設定すれば自動的にトラッキングURLに変換）
# ==========================================================================

# Amazonアソシエイト（直接） — 180日以内に3件売上の審査ハードルあり
#   申請: https://affiliate.amazon.co.jp/
#   承認後に発行される「トラッキングID」を設定。例: 'kyounoko-22'
#   下のもしも経由Amazonが設定されている場合はそちらが優先される
NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG=

# もしもアフィリエイト経由 楽天市場
#   管理画面: https://af.moshimo.com/af/shop/promotion/source?promotion_id=54&shop_site_id=668264
#   「広告取得」で発行される HTMLコードから a_id / pc_id / pl_id を抽出して設定
#   AffiliateLink で provider='rakuten' かつ URL が rakuten.co.jp 配下なら自動的に
#   もしも経由のトラッキングURLに変換される
NEXT_PUBLIC_MOSHIMO_A_ID=
NEXT_PUBLIC_MOSHIMO_RAKUTEN_P_ID=54
NEXT_PUBLIC_MOSHIMO_RAKUTEN_PC_ID=
NEXT_PUBLIC_MOSHIMO_RAKUTEN_PL_ID=

# もしもアフィリエイト経由 Amazon.co.jp（推奨：直接アソシエイトより審査が緩い）
#   管理画面で "Amazon" を検索 → 提携申請（多くは即承認）
#   承認後に発行されるHTMLコードから p_id / pc_id / pl_id を抽出
#   設定されていれば amazon.co.jp / amazon.com / amzn.to / amzn.asia 配下のURLが
#   自動でもしも経由URLに変換される（NEXT_PUBLIC_AMAZON_ASSOCIATE_TAG より優先）
NEXT_PUBLIC_MOSHIMO_AMAZON_P_ID=170
NEXT_PUBLIC_MOSHIMO_AMAZON_PC_ID=
NEXT_PUBLIC_MOSHIMO_AMAZON_PL_ID=

# Google AdSense
#   審査通過後に 'true' に設定すると広告スロット＋スクリプトが表示される。
#   未設定 or 'false' なら AdSlot コンポーネントは何もレンダリングしない
#   （審査中に空の「広告」ラベルだけ表示される UX 劣化を防ぐ）
#   ads.txt と <meta name="google-adsense-account"> は常に配信（審査用）。
NEXT_PUBLIC_ADSENSE_ENABLED=false

# ==========================================================================
# IndexNow（Bing / Yandex / Seznam 共通の即時インデックス通知 API）
# ==========================================================================
#
# キー本体（8〜128 文字の英数字）。public/{INDEXNOW_KEY}.txt の中身と一致させる。
# このリポジトリでは public/229166d73b10f1630ed52857e67c427b.txt を配置済み。
# 新しいキーに切り替えたい場合は、新キーで public/<新キー>.txt を作って
# このシークレットを更新する。
INDEXNOW_KEY=229166d73b10f1630ed52857e67c427b
#
# /api/indexnow/submit を叩くときの認可トークン（任意）。
# 設定すると ?token=... または Authorization: Bearer ... が必須になる。
# 本番では必ず設定推奨。
INDEXNOW_TRIGGER_TOKEN=

# ==========================================================================
# Google Indexing API（1日200URL／個別URL再クロール依頼）
# セットアップ手順: docs/indexing-api-setup.md
# ==========================================================================
#
# 方法A: JSONファイルへの絶対パス（推奨・ローカル開発）
#   .env.local では実パスを指定。リポジトリ外に置く（例: ~/.config/google/...）
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON_PATH=
#
# 方法B: JSONをそのまま環境変数に（CI/Vercel向け）
#   先頭が "{" であれば JSON 文字列として解釈される
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=

# ==========================================================================
# 再訪・UGC機能（2026-06 追加）
# ==========================================================================

# LINE公式アカウントの友だち追加URL（https://lin.ee/xxxx）
#   開設手順と配信テンプレ: docs/line-launch-kit.md
#   設定するとトップと記事末尾に「LINEで友だち追加」CTAが表示される。
#   未設定の間はCTA自体が描画されない。
NEXT_PUBLIC_LINE_ADD_FRIEND_URL=

# 「行ったよ」レポートのMicroCMS保存用APIキー（書き込み=POST権限つき）
#   MicroCMSで リスト形式API「spot-reports」を作成し、フィールドに
#   spotSlug(テキスト) / spotName(テキスト) / rating(数値) / comment(テキスト) / ageRange(テキスト)
#   を定義 → APIキー管理で「POST」を許可したキーを発行して設定。
#   投稿は下書きとして保存され、管理画面で「公開」にしたものだけ
#   スポット詳細の「みんなの行ったよ」に表示される。
#   未設定でもボタンは動作し、件数はGA4(spot_visited_report)で計測される。
MICROCMS_REPORTS_API_KEY=
