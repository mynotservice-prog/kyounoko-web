import type { Metadata } from 'next';
import Link from 'next/link';
import { V2Frame } from '@/components/v2/V2Frame';
import { getAllFileArticles } from '@/lib/articles';

export const revalidate = 3600;

export const metadata: Metadata = {
  title: '子供レシピ一覧｜離乳食・幼児食・お弁当・おやつまで【きょうのこレシピDB】',
  description:
    '0〜6歳の子ども向けレシピを月齢別・時短・お弁当・おやつ・離乳食・夏・冬で検索できるレシピデータベース。きょうのこの200本以上の子育てレシピから、いま作りたい一品が3分で見つかります。',
  alternates: { canonical: '/recipes' },
  openGraph: {
    title: '子供レシピ一覧｜きょうのこレシピDB',
    description: '0〜6歳の子ども向けレシピを月齢別・時短・お弁当・おやつで検索',
    url: 'https://kyounoko.jp/recipes',
    images: [{ url: '/img/ogp-default.jpg', width: 1200, height: 630 }],
  },
};

type Category = {
  id: string;
  label: string;
  emoji: string;
  /** タイトルに含まれていれば該当 */
  matchers: string[];
};

const CATEGORIES: Category[] = [
  { id: 'rinyu', label: '離乳食・幼児食', emoji: '🍼', matchers: ['離乳食', '幼児食', '1歳', '2歳', '3歳', '赤ちゃん', 'ベビー'] },
  { id: 'bento', label: 'お弁当', emoji: '🍱', matchers: ['弁当', 'お弁当', 'ベントー'] },
  { id: 'asagohan', label: '朝ごはん', emoji: '🌅', matchers: ['朝ごはん', '朝食', 'モーニング'] },
  { id: 'oyatsu', label: 'おやつ・お菓子', emoji: '🍪', matchers: ['おやつ', 'お菓子', 'スイーツ', 'ドーナツ', 'プリン', 'ゼリー', 'ホットケーキ', 'バナナ', 'アイス'] },
  { id: 'jitan', label: '時短・5分〜15分', emoji: '⏱️', matchers: ['5分', '10分', '15分', '時短', '即席', 'レンジ', 'すぐ'] },
  { id: 'natsu', label: '夏の子供レシピ', emoji: '☀️', matchers: ['夏', '冷たい', 'かき氷', 'ひんやり', 'そうめん'] },
  { id: 'fuyu', label: '冬の子供レシピ', emoji: '❄️', matchers: ['冬', '温かい', '鍋', '雑煮'] },
  { id: 'event', label: '行事・記念日', emoji: '🎉', matchers: ['ひな祭り', 'ハロウィン', 'クリスマス', 'お正月', 'おせち', '節分', '誕生日'] },
  { id: 'matome', label: '作り置き・冷凍', emoji: '🧊', matchers: ['冷凍', '作り置き', 'ストック', 'まとめ'] },
];

export default async function RecipesIndexPage() {
  const all = getAllFileArticles().filter((a) => !a.noindex);
  // レシピ寄り記事を全件抽出（料理関連のキーワードを持つもの）
  const recipeKeywords = [
    'レシピ', '料理', '弁当', '朝ごはん', '夕飯', '昼ごはん',
    'おやつ', 'お菓子', '離乳食', '幼児食', 'ドーナツ',
    'プリン', 'ゼリー', 'バナナ', 'ホットケーキ', 'おにぎり',
    '即席', '時短', '5分', '10分', '15分', 'カレー', 'ハンバーグ',
    '唐揚げ', '魚', '野菜', 'パスタ', 'うどん', 'そうめん',
    'チャーハン', '蒸しパン', 'アイス', 'チャーシュー',
    'クリスマス', 'ハロウィン', 'ひな祭り', 'おせち', '節分',
  ];
  const isRecipe = (title: string) =>
    recipeKeywords.some((k) => title.includes(k)) ||
    /(料理|レシピ|食|弁当|オヤツ|おやつ|甘い|デザート)/.test(title);

  const recipes = all.filter((a) => isRecipe(a.title));

  // カテゴリ別に分類
  const categorized = CATEGORIES.map((cat) => ({
    ...cat,
    articles: recipes
      .filter((r) => cat.matchers.some((m) => r.title.includes(m)))
      .slice(0, 30),
  })).filter((c) => c.articles.length > 0);

  // パンくず
  const jsonLdBreadcrumb = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'HOME', item: 'https://kyounoko.jp/' },
      { '@type': 'ListItem', position: 2, name: '子供レシピ一覧', item: 'https://kyounoko.jp/recipes' },
    ],
  };
  // CollectionPage
  const jsonLdCollection = {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://kyounoko.jp/recipes',
    name: '子供レシピ一覧｜きょうのこレシピDB',
    description: '0〜6歳の子ども向けレシピを月齢別・時短・お弁当・おやつで検索',
    inLanguage: 'ja',
    hasPart: recipes.slice(0, 50).map((r) => ({
      '@type': 'Article',
      name: r.title,
      url: `https://kyounoko.jp/article/${r.slug}`,
    })),
  };

  return (
    <>
      <script type="application/ld+json" dangerouslySetInnerHTML={{ __html: JSON.stringify(jsonLdBreadcrumb) }} />
      <script type="application/ld+json" dangerouslySetInnerHTML={{ __html: JSON.stringify(jsonLdCollection) }} />
      <V2Frame header="sub" active="home">
      <main className="container">
        <nav className="breadcrumb" aria-label="パンくず" style={{ padding: '12px 0 4px' }}>
          <Link href="/">HOME</Link>
          <span className="sep">/</span>
          <span>子供レシピ一覧</span>
        </nav>

        <section className="section" style={{ paddingTop: 8 }}>
          <h1
            style={{
              fontFamily: 'var(--font-mincho)',
              fontSize: 28,
              fontWeight: 700,
              margin: '4px 0 12px',
            }}
          >
            子供レシピ一覧｜きょうのこレシピDB
          </h1>
          <p style={{ fontSize: 14, color: 'var(--ink-sub)', lineHeight: 1.8, margin: '0 0 22px' }}>
            0〜6歳の子ども向けレシピを **{recipes.length}本以上** 掲載。月齢・時短・お弁当・おやつ・離乳食・行事ごはんなどカテゴリ別に検索できます。
            「いま作りたい一品」を3分で見つけてください。
          </p>

          <div style={{ display: 'grid', gap: 36 }}>
            {categorized.map((cat) => (
              <section key={cat.id} id={cat.id}>
                <h2
                  style={{
                    fontFamily: 'var(--font-mincho)',
                    fontSize: 20,
                    fontWeight: 600,
                    margin: '0 0 14px',
                    display: 'flex',
                    alignItems: 'center',
                    gap: 8,
                  }}
                >
                  <span aria-hidden style={{ fontSize: 22 }}>
                    {cat.emoji}
                  </span>
                  {cat.label}
                  <span
                    style={{
                      fontSize: 11,
                      fontFamily: 'var(--font-inter), sans-serif',
                      color: 'var(--ink-mute)',
                      fontWeight: 500,
                    }}
                  >
                    {cat.articles.length}件
                  </span>
                </h2>

                <ul
                  style={{
                    listStyle: 'none',
                    margin: 0,
                    padding: 0,
                    display: 'grid',
                    gap: 8,
                    gridTemplateColumns: 'repeat(auto-fill, minmax(280px, 1fr))',
                  }}
                >
                  {cat.articles.map((r) => (
                    <li key={r.slug}>
                      <Link
                        href={`/article/${r.slug}`}
                        style={{
                          display: 'flex',
                          alignItems: 'center',
                          gap: 12,
                          padding: '8px 10px',
                          borderRadius: 10,
                          border: '1px solid var(--line)',
                          background: 'var(--paper-card)',
                          textDecoration: 'none',
                          color: 'inherit',
                        }}
                      >
                        {r.hero && (
                          <span
                            aria-hidden
                            style={{
                              flex: '0 0 auto',
                              width: 56,
                              height: 42,
                              borderRadius: 6,
                              backgroundColor: 'var(--peach-soft)',
                              backgroundImage: `url(${r.hero})`,
                              backgroundSize: 'cover',
                              backgroundPosition: 'center',
                            }}
                          />
                        )}
                        <span
                          style={{
                            flex: 1,
                            fontFamily: 'var(--font-mincho)',
                            fontSize: 13,
                            fontWeight: 600,
                            lineHeight: 1.5,
                            overflow: 'hidden',
                            textOverflow: 'ellipsis',
                            display: '-webkit-box',
                            WebkitLineClamp: 2,
                            WebkitBoxOrient: 'vertical',
                          }}
                        >
                          {r.title}
                        </span>
                      </Link>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </section>
      </main>
      <SiteFooter />
      <MobileStickyNav />
    </>
  );
}
