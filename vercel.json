{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/cron/kpi-alert",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/pinterest-pin",
      "schedule": "0 0,6,12 * * *"
    }
  ]
}
