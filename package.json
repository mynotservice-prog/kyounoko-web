{
  "name": "kyounoko-web",
  "version": "0.1.0",
  "private": true,
  "description": "きょうのこ — 子育て家庭の「今日どうする？」を3分で決めるサイト",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-hero-manifest.mjs",
    "build": "next build",
    "postbuild": "node -e \"fetch('https://api.indexnow.org/indexnow',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({host:'kyounoko.jp',key:process.env.INDEXNOW_KEY||'229166d73b10f1630ed52857e67c427b',keyLocation:'https://kyounoko.jp/'+(process.env.INDEXNOW_KEY||'229166d73b10f1630ed52857e67c427b')+'.txt',urlList:['https://kyounoko.jp/','https://kyounoko.jp/sitemap.xml']})}).then(r=>console.log('IndexNow ping:',r.status)).catch(e=>console.log('IndexNow skip:',e.message))\"",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@google-analytics/data": "^5.2.1",
    "gray-matter": "^4.0.3",
    "microcms-js-sdk": "^3.2.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "swr": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
